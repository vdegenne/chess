{
	"name": "@vdegenne/chess",
	"version": "0.1.21",
	"description": "",
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/Chess.js",
			"types": "./types.d.ts"
		},
		"./utils.js": {
			"import": "./lib/utils.js",
			"types": "./lib/utils.d.ts"
		},
		"./commentary.js": {
			"import": "./lib/commentary/index.js",
			"types": "./lib/commentary/index.d.ts"
		},
		"./openings/": {
			"import": "./lib/openings/"
		}
	},
	"scripts": {
		"build": "wireit",
		"test": "wireit"
	},
	"files": [
		"./lib/",
		"./sounds/",
		"./types.d.ts",
		"./src/Chess.ts"
	],
	"devDependencies": {
		"chessboard-element": "^1.2.0",
		"lit": "^3.3.1",
		"typescript": "^5.9.2",
		"wireit": "^0.14.12"
	},
	"peerDependencies": {
		"chessboard-element": "^1.2.0",
		"lit": "^3.0.0"
	},
	"dependencies": {
		"chess.js": "^1.4.0"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src"
			],
			"output": [
				"./lib"
			]
		},
		"test": {
			"command": "node ./lib/test.js",
			"dependencies": [
				"build"
			]
		}
	}
}
